doctype html
html
  head
    title Update Custom Object Form | Integrating With HubSpot I Practicum.
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    .page
      h1 Update Custom Object Form | Integrating With HubSpot I Practicum.
      if error
        p.error #{error}
      .form-wrapper
        form(action="/update-cobj", method="post")
          label(for="name") Name
          input#name(type="text", name="name", required, value=values ? values.name : '')
          label(for="status") Status
          input#status(type="text", name="status", required, value=values ? values.status : '')
          label(for="notes") Notes
          textarea#notes(name="notes", rows="4")= values ? values.notes : ''
          input(type="submit", value="Submit")
      a.return-link(href="/") Return to the homepage
